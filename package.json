{
  "name": "ccc_web_news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plateforme de gestion des actualités universitaires",
  "keywords": [
    "vue",
    "news",
    "university",
    "platform"
  ],
  "author": "CCC Team",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:analyze": "vite build --mode analyze",
    "generate:api-types": "node scripts/generate-api-types.js",
    "sync:api-schema": "node scripts/sync-api-schema.js",
    "sync:api-schema:watch": "node scripts/sync-api-schema.js --watch",
    "api:validate": "node -e \"import('./src/services/api-schema-validator.js').then(m => console.log('Validation disponible:', m.apiSchemaValidator.getAvailableEndpoints().length, 'endpoints'))\"",
    "deploy:vercel": "npx vercel --prod",
    "deploy:netlify": "npx netlify deploy --prod --dir=dist",
    "deploy:surge": "npm run build && npx surge dist ccc-web-news.surge.sh",
    "deploy:firebase": "npm run build && firebase deploy",
    "docker:build": "docker build -t ccc-web-news .",
    "docker:run": "docker run -p 80:80 ccc-web-news",
    "lint": "echo 'Linting not configured yet'",
    "test": "echo 'Tests not configured yet'"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@vue/cli-plugin-pwa": "^3.12.1",
    "chart.js": "^4.5.1",
    "chartjs": "^0.3.24",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "terser": "^5.16.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3"
  }
}
